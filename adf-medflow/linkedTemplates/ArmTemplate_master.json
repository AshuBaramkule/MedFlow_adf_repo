{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-medflow"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1121-092724-w84llexn"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://medflowproject.dfs.core.windows.net/"
		},
		"LS_AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://medflow-keyvault.vault.azure.net/"
		},
		"LS_AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "medflow-server.database.windows.net"
		},
		"LS_AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-medflow"
		},
		"LS_AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Ashutosh"
		},
		"LS_PostgreSql1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-long-dawn-a1o8i74z-pooler.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgreSql1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-medflow_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"LS_AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"LS_PostgreSql1_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSql1_properties_typeProperties_server')]"
					},
					"LS_PostgreSql1_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSql1_properties_typeProperties_database')]"
					},
					"LS_PostgreSql1_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSql1_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}